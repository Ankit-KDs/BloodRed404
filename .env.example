# ==============================================================================
# RED404 ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the project root or server environment.
# 2. Fill in the values for your deployment environment.
# 3. DO NOT COMMIT `.env` or ANY SECRET VALUES TO VERSION CONTROL.
# ==============================================================================

# Application Environment Mode ('development' | 'staging' | 'production')
ENVIRONMENT=development
# Set to 'true' to strictly enforce all production secret checks on startup
RED404_STRICT_ENV=false

# Server Configuration
PORT=8080

# ------------------------------------------------------------------------------
# Database Configuration (MySQL / Cloud Database)
# ------------------------------------------------------------------------------
# If running MySQL locally or on a cloud provider (Railway, Render, AWS RDS)
MYSQLHOST=127.0.0.1
MYSQLPORT=3307
MYSQLDATABASE=red404
MYSQLUSER=root
MYSQLPASSWORD=
# Alternative full connection string (overrides individual host/port if set)
DATABASE_URL=
MYSQL_URL=

# ------------------------------------------------------------------------------
# Super Admin Stealth Authentication Secret
# ------------------------------------------------------------------------------
# Required for Super Admin Level-0 access. In production, this MUST be set
# to a high-entropy string (at least 32 characters).
RED404_ADMIN_SECRET= 
RED404_ADMIN_EMAIL= 

# ------------------------------------------------------------------------------
# Email Service Provider (Brevo / Sendinblue / SMTP)
# ------------------------------------------------------------------------------
# Options: 'brevo' | 'smtp' | 'mock'
EMAIL_PROVIDER=mock
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Daily outgoing email send cap (prevents unexpected billing surges)
EMAIL_DAILY_LIMIT=500

# SMTP Fallback Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# Web Push (VAPID Keys)
# ------------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ------------------------------------------------------------------------------
# Redis Configuration (Optional: for distributed rate-limiting & realtime Pub/Sub)
# ------------------------------------------------------------------------------
# If left empty, system automatically uses in-memory concurrent sliding-window.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Public Client-Side Google Maps API Key
# ------------------------------------------------------------------------------
# NOTE: This key is loaded in client browsers. Restrict it in GCP Console:
# 1. Application restrictions: HTTP referrers (e.g., https://yourdomain.com/*)
# 2. API restrictions: Maps JavaScript API, Geocoding API only.
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Base Application URL
# ------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:8080
